# Coinbase Advanced Trade / Coinbase Advanced API keys
# The existing codebase primarily uses these names:
API_KEY=
API_SECRET=
API_KEY_PERPS=
API_SECRET_PERPS=

# Optional aliases used by the enhanced dashboard modules:
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=
COINBASE_PERP_API_KEY=
COINBASE_PERP_API_SECRET=

# Optional: disable private portfolio/fills sync in the dashboard.
ENABLE_PORTFOLIO_SYNC=true

# Optional timeouts/caching for public market data (Exchange public endpoints):
COINBASE_PUBLIC_CACHE_TTL_SEC=300
COINBASE_PUBLIC_TIMEOUT_SEC=10

# Optional output locations / briefing controls:
KNOWLEDGE_VAULT_ROOT=research_agent/knowledge_vault
REGIME_HISTORY_CSV=regime_history_BTC.csv
TRADE_CHECKPOINT_START=2026-01-15
TRADE_CHECKPOINT_TARGET=150
